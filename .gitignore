# فایل‌های دیتابیس (Database files)
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm

# فایل‌های تنظیمات و اطلاعات محرمانه (Environment variables)
.env
.env.*
!.env.example

# پوشه‌ی محیط مجازی پایتون (Python virtual environments)
venv/
.venv/
env/
ENV/
venv.bak/
env.bak/

# پوشه‌ها و فایل‌های ساخته‌شده‌ی خودکار پایتون (Python auto-generated)
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# پوشه‌ها و فایل‌های ساخته‌شده‌ی خودکار فرانت‌اند / Node
node_modules/
dist/
dist-ssr/
.vite/
*.local

# فایل‌های ویرایشگر و سیستم‌عامل (Editor & OS)
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db

# فایل‌های لاگ (Logs)
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
